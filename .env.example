# Copy to .env to use a hosted LLM for cite-then-write. Leave unset for the default
# offline extractive generator (no key needed, fully reproducible). Never commit .env.
#
# Any OpenAI-compatible endpoint works (OpenAI, Gemini's OpenAI-compatible API, Ollama, vLLM):
# LLM_BACKEND=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-key-here
# LLM_MODEL=gemini-2.5-flash
#
# Threshold overrides (see engine/config.py), e.g.
# RAG_LOW_CONF_THRESHOLD=0.30
